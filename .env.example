# Database (Prisma connects here)
# Local Docker Postgres: postgresql://postgres:postgrespassword@localhost:5432/candidate_screener?schema=public
# Supabase Production: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/candidate_screener?schema=public"
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/candidate_screener?schema=public"

# Supabase Auth & Client
NEXT_PUBLIC_SUPABASE_URL="https://example-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="example-anon-key"
SUPABASE_SERVICE_ROLE_KEY="example-service-role-key"

# Google Gemini API
GEMINI_API_KEY=""
